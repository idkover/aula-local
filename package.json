{
  "name": "aula-local",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Clase en red local: diapositivas sincronizadas y pizarrón, sin internet.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,green \"vite build --watch\" \"tsx watch server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "package:win": "node scripts/package-win.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "archiver": "^8.0.0",
    "express": "^5.3.0",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^10.0.6",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
